            resizeHandle.addEventListener('pointerdown', (e) => {
                if (e.pointerType === 'mouse' && e.button !== 0) return;
                e.preventDefault();
                const rect = panel.getBoundingClientRect();
                panel.style.width = `${rect.width}px`;
                panel.style.height = `${rect.height}px`;
                panel.style.maxHeight = 'none';
                resizeState = { pointerId: e.pointerId, x: e.clientX, y: e.clientY, width: rect.width, height: rect.height };
                resizeHandle.setPointerCapture(e.pointerId);
            });
            resizeHandle.addEventListener('pointermove', (e) => {
                if (!resizeState || e.pointerId !== resizeState.pointerId) return;
                e.preventDefault();
                const rect = panel.getBoundingClientRect();
                panel.style.width = `${clamp(resizeState.width + e.clientX - resizeState.x,
                    minWidth(), Math.max(minWidth(), window.innerWidth - rect.left - 8))}px`;
                panel.style.height = `${clamp(resizeState.height + e.clientY - resizeState.y,
                    minHeight(), Math.max(minHeight(), window.innerHeight - rect.top - 8))}px`;
