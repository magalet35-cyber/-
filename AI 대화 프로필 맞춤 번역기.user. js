    // 입력 토큰은 GM 설정에만 저장한다. 교환된 JWT는 메모리에만 보관한다.
    let appCheckCache = null;
    function readAppCheckJwt(token) {
        const parts = token.split('.');
        if (parts.length !== 3 || parts.some(part => !/^[A-Za-z0-9_-]+$/.test(part))) {
            throw new Error('App Check JWT 형식을 확인해 주세요.');
        }
        let payload;
        try {
            const encoded = parts[1].replace(/-/g, '+').replace(/_/g, '/');
            payload = JSON.parse(atob(encoded.padEnd(Math.ceil(encoded.length / 4) * 4, '=')));
        } catch (_) { throw new Error('App Check JWT 형식을 확인해 주세요.'); }
        const expireTimeMillis = typeof payload.exp === 'number' ? payload.exp * 1000 : NaN;
        if (!Number.isFinite(expireTimeMillis)) throw new Error('만료 시간이 없는 App Check JWT입니다.');
        if (expireTimeMillis <= Date.now() + 30000) {
            throw new Error('App Check JWT가 만료됐거나 곧 만료됩니다. 새 토큰을 넣고 저장해 주세요.');
        }
        // 서명·앱 일치 여부는 Firebase 서버가 검증한다.
        return { token, expireTimeMillis };
    }

    async function getConfiguredAppCheckToken(config, input) {
        const secret = input.trim().replace(/^Bearer\s+/i, '');
        if (secret.includes('.')) return readAppCheckJwt(secret);
        if (!secret || /\s/.test(secret)) throw new Error('App Check 디버그 토큰 형식을 확인해 주세요.');
        if (!config.projectId || !config.appId || !config.apiKey) {
            throw new Error('디버그 토큰을 쓰려면 Firebase 설정에 projectId, appId, apiKey가 필요합니다.');
        }
        const cacheKey = JSON.stringify([config.projectId, config.appId, config.apiKey, secret]);
        if (appCheckCache?.key === cacheKey && appCheckCache.value.expireTimeMillis > Date.now() + 60000) {
            return appCheckCache.value;
        }
        const value = await new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                method: 'POST',
                url: `https://firebaseappcheck.googleapis.com/v1/projects/${encodeURIComponent(config.projectId)}/apps/${encodeURIComponent(config.appId)}:exchangeDebugToken?key=${encodeURIComponent(config.apiKey)}`,
                headers: { 'Content-Type': 'application/json' },
                data: JSON.stringify({ debugToken: secret }),
                timeout: 15000,
                onload: (res) => {
                    if (res.status < 200 || res.status >= 300) {
                        return reject(new Error(`App Check 토큰 교환 실패 (${res.status}). Firebase 설정과 해당 앱의 디버그 토큰 등록을 확인해 주세요.`));
                    }
                    try {
                        const data = JSON.parse(res.responseText);
                        const jwt = readAppCheckJwt(data.token || '');
                        const ttlSeconds = /^\d+(?:\.\d+)?s$/.test(data.ttl || '') ? parseFloat(data.ttl) : NaN;
                        if (Number.isFinite(ttlSeconds)) {
                            jwt.expireTimeMillis = Math.min(jwt.expireTimeMillis, Date.now() + ttlSeconds * 1000);
                        }
                        if (jwt.expireTimeMillis <= Date.now() + 30000) throw new Error('short TTL');
                        resolve(jwt);
                    } catch (_) { reject(new Error('App Check 토큰 응답이 올바르지 않습니다.')); }
                },
                onerror: () => reject(new Error('App Check 토큰 교환 중 네트워크 오류가 발생했습니다.')),
                ontimeout: () => reject(new Error('App Check 토큰 교환 시간이 초과됐습니다.'))
            });
        });
        appCheckCache = { key: cacheKey, value };
        return value;
    }

    async function configureFirebaseAppCheck(app, config) {
        const input = (settings.firebaseAppCheckToken || '').trim();
        if (!input) return;
        const { initializeAppCheck, CustomProvider, getToken } = await import('https://www.gstatic.com/firebasejs/12.8.0/firebase-app-check.js');
        const appCheck = initializeAppCheck(app, {
            provider: new CustomProvider({ getToken: () => getConfiguredAppCheckToken(config, input) }),
            isTokenAutoRefreshEnabled: false
        });
        // 사전 확인 후 AI SDK가 X-Firebase-AppCheck 헤더에 토큰을 전달한다.
        // 수동 JWT는 자동 재발급할 수 없으므로 만료 시 입력을 갱신해야 한다.
        await getToken(appCheck, true);
    }

