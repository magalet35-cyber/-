            const clamp = (value, min, max) => Math.max(min, Math.min(value, max));
            const minWidth = () => Math.min(280, Math.max(1, window.innerWidth - 16));
            const minHeight = () => Math.min(300, Math.max(1, window.innerHeight - 16));
            const fitPanelToViewport = () => {
                if (panel.style.display !== 'flex') return;
                const rect = panel.getBoundingClientRect();
                const maxLeft = Math.max(0, window.innerWidth - minWidth() - 8);
                const maxTop = Math.max(0, window.innerHeight - minHeight() - 8);
                const left = clamp(rect.left, 0, maxLeft);
                const top = clamp(rect.top, 0, maxTop);
                panel.style.left = `${left}px`;
                panel.style.top = `${top}px`;
                panel.style.width = `${clamp(rect.width, minWidth(), Math.max(minWidth(), window.innerWidth - left - 8))}px`;
                if (panel.style.height) {
                    panel.style.height = `${clamp(rect.height, minHeight(), Math.max(minHeight(), window.innerHeight - top - 8))}px`;
                }
            };
            panel.aitFitToViewport = fitPanelToViewport;

            try {
                const saved = GM_getValue(PANEL_SIZE_KEY, '');
                const size = typeof saved === 'string' ? JSON.parse(saved) : saved;
                if (size && Number.isFinite(size.width) && Number.isFinite(size.height)) {
                    panel.style.width = `${clamp(size.width, minWidth(), Math.max(minWidth(), window.innerWidth - 16))}px`;
                    panel.style.height = `${clamp(size.height, minHeight(), Math.max(minHeight(), window.innerHeight - 16))}px`;
                    panel.style.maxHeight = 'none';
                }
            } catch (e) { /* 저장된 크기가 손상됐으면 기본 크기로 표시 */ }

            window.addEventListener('resize', fitPanelToViewport);

            const resizeHandle = document.getElementById('ait-resize-handle');
