// ==UserScript==
// @name         AI 대화 프로필 맞춤 번역기
// @namespace    http://tampermonkey.net/
// @version      5.5
// @description  대화 프로필 자동 적용, 윤문·번역 지침, Firebase App Check, API 예상 비용
// @match        https://crack.wrtn.ai/*
// @grant        GM_addStyle
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        GM_xmlhttpRequest
// @connect      generativelanguage.googleapis.com
// @connect      crack-api.wrtn.ai
// @connect      api.frankfurter.dev
// @connect      firebaseappcheck.googleapis.com
// ==/UserScript==

(function() {
    'use strict';

    // ===================================================================================
    // [상태 관리]
    // ===================================================================================
    const DEFAULT_FORMAT = '{번역문} ({원문})';

    let settings = JSON.parse(GM_getValue('AITrans_settings', 
        '{"provider":"google","apiKey":"","firebaseConfig":"","model":"gemini-3.8-flash","lang":"English","customLang":"","format":"' + DEFAULT_FORMAT.replace(/"/g, '\\"') + '","useContext":true,"usePolish":false,"maxLength":1000,"useTranslation":true,"creativity":"medium","thinkingLevel":"medium","contextLimit":6}'
    ));
    
    if (settings.firebaseAppCheckToken === undefined) settings.firebaseAppCheckToken = '';
    if (settings.format === undefined) settings.format = DEFAULT_FORMAT;
    if (settings.customLang === undefined) settings.customLang = '';
    if (settings.useContext === undefined) settings.useContext = true;
    if (settings.usePolish === undefined) settings.usePolish = false;
    if (settings.maxLength === undefined) settings.maxLength = 1000;
    if (settings.useTranslation === undefined) settings.useTranslation = true;
    // V4.x의 reasoning 값은 실제 추론이 아니라 temperature 단계였으므로 표현 강도로 이전한다.
    if (settings.creativity === undefined) settings.creativity = settings.reasoning || 'medium';
    if (settings.thinkingLevel === undefined) settings.thinkingLevel = 'medium';
    if (settings.contextLimit === undefined) settings.contextLimit = 6;

    function saveSettings() { GM_setValue('AITrans_settings', JSON.stringify(settings)); }

    // 어시스턴트 3.40.0과 같은 방-대화 프로필 연결 규칙을 사용한다.
    // 예전 AITrans_chars 데이터는 지우지 않지만 새 요청에는 사용하지 않는다.
    const profileBase = 'https://crack-api.wrtn.ai';
    const getCurrentChatId = () => location.pathname.match(/(?:episodes|chats?)\/([a-zA-Z0-9]{8,})/)?.[1] || null;
    let activeProfile = { chatId: null, status: 'idle', name: '', information: '', checkedAt: 0 };
    let profileLoad = null;
    function showProfile() {
        const el = document.getElementById('ait-profile-status');
        if (!el) return;
        el.textContent = activeProfile.status === 'ready'
            ? `${activeProfile.name || '이름 없음'} · 현재 방에 자동 적용`
            : activeProfile.status === 'loading' ? '현재 방 대화 프로필을 확인하는 중…'
            : activeProfile.status === 'missing' ? '현재 방에 연결된 대화 프로필이 없어요'
            : activeProfile.status === 'error' ? '대화 프로필을 읽지 못했어요 · 다시 열거나 번역을 눌러 재시도'
            : '채팅방에 들어가면 대화 프로필을 자동으로 읽어요';
        el.dataset.status = activeProfile.status;
        el.title = activeProfile.status === 'ready' ? activeProfile.information : '';
    }
    function requestJson(url) {
        const direct = async () => {
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), 5000);
            try {
                const token = document.cookie.split(';').map(s => s.trim()).find(s => s.startsWith('access_token='))?.slice(13);
                const response = await fetch(url, { credentials: 'include', signal: controller.signal,
                    headers: token ? { Authorization: `Bearer ${token}` } : {} });
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                return await response.json();
            } finally { clearTimeout(timeout); }
        };
        // 어시스턴트가 설치되어 있으면 이미 수집한 인증 헤더로 가져오는 경로도 이용한다.
        if (!document.getElementById('cwa-host')) return direct();
        const assistant = new Promise((resolve, reject) => {
            const done = (error, value) => { clearTimeout(timer); window.removeEventListener('cwa-capture', receive);
                error ? reject(error) : resolve(value); };
            const receive = (event) => {
                const data = event.detail;
                if (!data || String(data.url).split('?')[0] !== url) return;
                try {
                    if (data.status < 200 || data.status >= 300) throw new Error(`HTTP ${data.status}`);
                    done(null, JSON.parse(data.body));
                } catch (error) { done(error); }
            };
            const timer = setTimeout(() => done(new Error('대화 프로필 응답 시간 초과')), 5500);
            window.addEventListener('cwa-capture', receive);
            window.dispatchEvent(new CustomEvent('cwa-fetch', { detail: url }));
        });
        return Promise.any([direct(), assistant]);
    }
    async function syncCurrentProfile(force = false) {
        const chatId = getCurrentChatId();
        if (!chatId) {
            activeProfile = { chatId: null, status: 'idle', name: '', information: '', checkedAt: 0 };
            showProfile();
            return activeProfile;
        }
        if (profileLoad?.chatId === chatId) return profileLoad.promise;
        if (!force && activeProfile.chatId === chatId && activeProfile.status === 'ready' && Date.now() - activeProfile.checkedAt < 30000)
            return activeProfile;
        activeProfile = { chatId, status: 'loading', name: '', information: '', checkedAt: 0 };
        showProfile();
        const promise = (async () => {
            try {
                const [roomJson, accountJson] = await Promise.all([
                    requestJson(`${profileBase}/crack-gen/v3/chats/${chatId}`),
                    requestJson(`${profileBase}/crack-api/profiles`)
                ]);
                const room = roomJson?.data;
                const accountId = accountJson?.data?._id;
                const wantedId = room?.chatProfile?._id;
                if (!room || !accountId) throw new Error('방 또는 계정 정보가 없음');
                const profilesJson = await requestJson(`${profileBase}/crack-api/profiles/${encodeURIComponent(accountId)}/chat-profiles`);
                const list = profilesJson?.data?.chatProfiles;
                if (!Array.isArray(list)) throw new Error('대화 프로필 목록이 없음');
                const selected = wantedId ? list.find(p => p?._id === wantedId)
                    : list.find(p => p?.isRepresentative) || list[0];
                if (getCurrentChatId() !== chatId) return activeProfile;
                activeProfile = selected && (selected.name || selected.information)
                    ? { chatId, status: 'ready', name: String(selected.name || '').trim(),
                        information: String(selected.information || '').trim(), checkedAt: Date.now() }
                    : { chatId, status: 'missing', name: '', information: '', checkedAt: Date.now() };
            } catch (error) {
                if (getCurrentChatId() !== chatId) return activeProfile;
                activeProfile = { chatId, status: 'error', name: '', information: '', checkedAt: Date.now() };
            }
            showProfile();
            return activeProfile;
        })();
        profileLoad = { chatId, promise };
        try { return await promise; }
        finally { if (profileLoad?.promise === promise) profileLoad = null; }
    }

    // 이 브라우저의 Tampermonkey 저장소에 토큰·예상 비용만 저장한다 (원문/응답/키는 저장하지 않음).
    const USAGE_KEY = 'AITrans_usage_v1';
    const PANEL_SIZE_KEY = 'AITrans_panelSize_v1';
    const FX_KEY = 'AITrans_fx_USDKRW_v1';
    const emptyUsage = () => ({ count: 0, input: 0, output: 0, thinking: 0, total: 0, cached: 0,
        pricedCount: 0, usd: 0, krwCount: 0, krw: 0, last: null });
    let usage = emptyUsage();
    try {
        const saved = GM_getValue(USAGE_KEY, '{}');
        const parsed = typeof saved === 'string' ? JSON.parse(saved) : saved;
        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) usage = { ...emptyUsage(), ...parsed };
    } catch (e) { usage = emptyUsage(); }

    let exchangeRate = null;
    let fxAttempted = false;
    try {
        const saved = GM_getValue(FX_KEY, '{}');
        const parsed = typeof saved === 'string' ? JSON.parse(saved) : saved;
        if (Number.isFinite(parsed.rate) && parsed.rate > 0 && /^\d{4}-\d{2}-\d{2}$/.test(parsed.date)) exchangeRate = parsed;
    } catch (e) { /* 환율은 연결되면 다시 가져온다 */ }
    let fxRequest = null;
    const koreaDay = () => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul', year: 'numeric', month: '2-digit', day: '2-digit' })
        .format(new Date());

    function refreshExchangeRate() {
        if (exchangeRate?.checkedDay === koreaDay()) return Promise.resolve(exchangeRate);
        if (fxRequest) return fxRequest;
        fxAttempted = true;
        fxRequest = new Promise(resolve => {
            GM_xmlhttpRequest({
                method: 'GET', url: 'https://api.frankfurter.dev/v2/rate/usd/krw', timeout: 6000,
                onload: response => {
                    try {
                        const data = JSON.parse(response.responseText);
                        if (response.status >= 200 && response.status < 300 && Number.isFinite(data.rate) && data.rate > 0 && /^\d{4}-\d{2}-\d{2}$/.test(data.date)) {
                            exchangeRate = { rate: data.rate, date: data.date, checkedDay: koreaDay() };
                            GM_setValue(FX_KEY, JSON.stringify(exchangeRate));
                        }
                    } catch (e) { /* 환율 조회 실패 시 마지막 환율 사용 */ }
                    renderUsage(); resolve(exchangeRate);
                },
                onerror: () => resolve(exchangeRate), ontimeout: () => resolve(exchangeRate)
            });
        }).catch(() => exchangeRate).finally(() => { fxRequest = null; renderUsage(); });
        return fxRequest;
    }

    // Google Developer API 및 Firebase Vertex AI 글로벌 표준 유료 요금 (USD / 1M 토큰).
    // 요금 변경 시 공식 표를 확인해 갱신한다. 미지원 모델은 임의 요금을 적용하지 않는다.
    const PRICES = {
        'gemini-3.8-flash': { input: .75, output: 3.75, cached: .075, after2026: true },
        'gemini-3.7-flash': { input: .75, output: 3.75, cached: .075, after2026: true },
        'gemini-3.5-flash': { input: 1.5, output: 9, cached: .15 },
        'gemini-3.1-flash-lite-preview': { input: .25, output: 1.5, cached: .025 },
        'gemini-3.1-pro-preview': { input: 2, output: 12, cached: .2, longInput: true }
    };
    function priceFor(model, input) {
        const price = PRICES[model];
        if (!price) return null;
        if (price.after2026 && koreaDay() >= '2027-01-01') return { input: 1.5, output: 7.5, cached: .15 };
        if (price.longInput && input > 200000) return { input: 4, output: 18, cached: .4 };
        return price;
    }

    const tokenNumber = (value) => Number.isFinite(Number(value)) && Number(value) >= 0 ? Number(value) : 0;
    const formatTokens = (value) => tokenNumber(value).toLocaleString('ko-KR');
    const formatUsd = (value) => value > 0 && value < .000001 ? '<$0.000001'
        : `$${Number(value).toLocaleString('en-US', { minimumFractionDigits: 4, maximumFractionDigits: 6 })}`;
    const formatKrw = (value) => value > 0 && value < .005 ? '<₩0.01'
        : `₩${Number(value).toLocaleString('ko-KR', { minimumFractionDigits: 0, maximumFractionDigits: 2 })}`;

    function renderUsage() {
        const last = usage.last;
        const set = (id, value) => {
            const el = document.getElementById(id);
            if (el) el.textContent = value;
        };
        set('ait-last-total', last ? formatTokens(last.total) : '—');
        set('ait-all-total', formatTokens(usage.total));
        set('ait-last-breakdown', last
            ? `입력 ${formatTokens(last.input)} · 출력 ${formatTokens(last.output)} · 추론 ${formatTokens(last.thinking)}`
            : '아직 기록된 요청이 없어요');
        set('ait-all-breakdown', `입력 ${formatTokens(usage.input)} · 출력 ${formatTokens(usage.output)} · 추론 ${formatTokens(usage.thinking)}`);
        set('ait-last-cost', last && Number.isFinite(last.usd)
            ? `${formatUsd(last.usd)} · ${Number.isFinite(last.krw) ? formatKrw(last.krw) : '원화 계산 불가'}` : '비용 기록 없음');
        set('ait-all-cost', tokenNumber(usage.pricedCount)
            ? `${formatUsd(usage.usd)} · ${tokenNumber(usage.krwCount) ? formatKrw(usage.krw) : '원화 계산 불가'}` : '비용 기록 없음');
        set('ait-fx-note', exchangeRate
            ? `USD/KRW ${formatKrw(exchangeRate.rate)} (1달러 · ${exchangeRate.date} 기준${exchangeRate.checkedDay === koreaDay() ? '' : ', 마지막 저장값'})`
            : fxAttempted && !fxRequest ? '원화 환율 조회 실패 · 연결되면 다시 시도' : '원화 환율 조회 중 · 연결되지 않으면 달러만 표시');
        set('ait-usage-note', last
            ? `직전 ${last.model} · ${last.provider === 'firebase' ? 'Firebase' : 'Google API'} · 기록 ${formatTokens(usage.count)}회` +
              (last.cached > 0 ? ` · 직전 캐시 ${formatTokens(last.cached)}` : '') +
              (last.fxDate ? ` · 직전 원화 ${last.fxDate} 환율` : '') +
              (tokenNumber(usage.pricedCount) < tokenNumber(usage.count) ? ` · 비용 기록 ${formatTokens(usage.pricedCount)}회` : '') +
              (tokenNumber(usage.krwCount) < tokenNumber(usage.pricedCount) ? ` · 원화 기록 ${formatTokens(usage.krwCount)}회` : '')
            : 'API 응답에 사용량이 포함된 요청부터 집계합니다');
        const btn = document.getElementById('ai-trans-btn');
        if (btn) btn.title = last ? `대화 프로필 번역/교정 · 직전 ${formatTokens(last.total)}토큰` : '대화 프로필 번역/교정';
    }

    function recordUsage(meta, provider, model) {
        if (!meta || typeof meta !== 'object' ||
            !['promptTokenCount', 'candidatesTokenCount', 'thoughtsTokenCount', 'totalTokenCount']
                .some(key => Number.isFinite(Number(meta[key])))) return null;
        const input = tokenNumber(meta.promptTokenCount);
        const output = tokenNumber(meta.candidatesTokenCount);
        const thinking = tokenNumber(meta.thoughtsTokenCount);
        const total = meta.totalTokenCount == null ? input + output + thinking : tokenNumber(meta.totalTokenCount);
        const cached = Math.min(input, tokenNumber(meta.cachedContentTokenCount));
        const entry = { input, output, thinking, total, cached, provider, model, at: Date.now() };
        const price = priceFor(model, input);
        if (price) {
            entry.usd = ((input - cached) * price.input + cached * price.cached +
                (output + thinking) * price.output) / 1000000;
            usage.usd = tokenNumber(usage.usd) + entry.usd;
            usage.pricedCount = tokenNumber(usage.pricedCount) + 1;
            if (exchangeRate?.rate) {
                entry.fxRate = exchangeRate.rate;
                entry.fxDate = exchangeRate.date;
                entry.krw = entry.usd * entry.fxRate;
                usage.krw = tokenNumber(usage.krw) + entry.krw;
                usage.krwCount = tokenNumber(usage.krwCount) + 1;
            }
        }
        for (const key of ['input', 'output', 'thinking', 'total', 'cached']) {
            usage[key] = tokenNumber(usage[key]) + entry[key];
        }
        usage.count = tokenNumber(usage.count) + 1;
        usage.last = entry;
        try { GM_setValue(USAGE_KEY, JSON.stringify(usage)); } catch (e) { /* 화면 표시만 유지 */ }
        renderUsage();
        return entry;
    }

    // ===================================================================================
    // [테마 감지]
    // ===================================================================================
    function isDarkTheme() {
        const html = document.documentElement;
        const body = document.body;
        const hints = [
            html.getAttribute('data-theme'), html.getAttribute('data-color-mode'), html.className,
            body?.getAttribute('data-theme'), body?.getAttribute('data-color-mode'), body?.className
        ].join(' ').toLowerCase();

        if (/\bdark\b|theme-dark|dark-mode|darkmode|color-scheme-dark/.test(hints)) return true;
        if (/\blight\b|theme-light|light-mode|lightmode|color-scheme-light/.test(hints)) return false;

        try {
            const probe = document.createElement('span');
            probe.style.cssText = 'position:fixed;left:-9999px;color:var(--text_primary, var(--foreground, inherit));';
            document.documentElement.appendChild(probe);
            const rgb = getComputedStyle(probe).color.match(/\d+/g);
            probe.remove();
            if (rgb && rgb.length >= 3) {
                const lum = (0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2]) / 255;
                if (lum > 0.58) return true;
                if (lum < 0.42) return false;
            }
        } catch (e) {}

        return window.matchMedia?.('(prefers-color-scheme: dark)')?.matches || false;
    }

    function applyAitTheme() {
        const theme = isDarkTheme() ? 'dark' : 'light';
        document.getElementById('ai-trans-panel')?.setAttribute('data-ait-theme', theme);
        document.getElementById('ai-trans-inline-group')?.setAttribute('data-ait-theme', theme);
    }

    function setReactValue(el, value) {
        if (el.isContentEditable) {
            el.innerText = value;
            el.dispatchEvent(new Event("input", { bubbles: true }));
            return;
        }

        const proto = el.tagName === "TEXTAREA" ? window.HTMLTextAreaElement.prototype : window.HTMLInputElement.prototype;
        const setter = Object.getOwnPropertyDescriptor(proto, "value")?.set;
        if (setter) setter.call(el, value);
        else el.value = value;

        el.dispatchEvent(new Event("input", { bubbles: true }));
        el.dispatchEvent(new Event("change", { bubbles: true }));

        if(el.tagName === "TEXTAREA") {
            el.style.height = 'auto';
            el.style.height = el.scrollHeight + 'px';
        }
    }

    function toast(msg, type = "info") {
        const palette = { success:"#73af85", warn:"#d3a766", error:"#d47a7a", info:"#aab2bd" };
        const el = document.createElement("div");
        el.textContent = msg;
        el.style.cssText = `
            position:fixed; bottom:80px; left:50%; transform:translateX(-50%);
            z-index:999999; background:rgba(20,22,30,.94); color:#eceef6;
            padding:10px 16px; border-radius:10px; font-size:12px; font-weight:bold;
            border:1px solid rgba(205,216,255,.16); border-left:3px solid ${palette[type]||palette.info};
            box-shadow:0 8px 24px rgba(0,0,0,.4); transition:opacity .4s; white-space:nowrap;
            backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);
        `;
        document.body.appendChild(el);
        setTimeout(() => { el.style.opacity="0"; setTimeout(()=>el.remove(),400); }, 3000);
    }

    // ===================================================================================
    // [스타일 정의]
    // ===================================================================================
    GM_addStyle(`
        #ai-trans-inline-group { display: flex; align-items: center; gap: 6px; margin-right: 8px; }
        #ai-trans-inline-group > button {
            width: 1.7rem; height: 1.7rem; min-width: 1.7rem; min-height: 1.7rem;
