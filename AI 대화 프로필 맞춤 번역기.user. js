        #ai-trans-panel[data-ait-theme="light"] .ai-input:focus { border-color: #747b85; }
        #ai-trans-panel .ai-input:focus-visible, #ai-trans-panel button:focus-visible, #ai-trans-panel summary:focus-visible {
