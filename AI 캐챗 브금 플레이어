// @connect      m.youtube.com
// @connect      www.youtube.com
// @connect      html.duckduckgo.com
// ==/UserScript==

(function() {
    'use strict';

    let currentVideoIds = ['jfKfPfyJRdk']; 
    let currentVideoIndex = 0;
    let ytPlayer;
    let isYtReady = false;
    let currentSearchQuery = "롤플레잉 배경음악";
    
    // 🔥 자동화 관련 변수
    let lastContextHash = 0;
    let autoSyncTimer = null;
    let autoTurnCounter = 0;
    const AUTO_TURN_THRESHOLD = 6; 

    let settings = JSON.parse(GM_getValue('AIBGM_settings', '{"provider":"google","apiKey":"","firebaseConfig":"","model":"gemini-3.5-flash","autoSync":false}'));
    function saveSettings() { GM_setValue('AIBGM_settings', JSON.stringify(settings)); }

    // ===================================================================================
    // [1] 유튜브 IFrame API - 숨겨진 백그라운드 플레이어
    // ===================================================================================
    const tag = document.createElement('script');
    tag.src = "https://www.youtube.com/iframe_api";
    document.head.appendChild(tag);

    const checkYtReady = setInterval(() => {
        const globalWindow = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
        if (globalWindow.YT && globalWindow.YT.Player) {
            clearInterval(checkYtReady); 
            
            const placeholder = document.createElement('div');
            placeholder.id = 'yt-hidden-player';
            Object.assign(placeholder.style, { position:'fixed', top:'0', left:'0', width:'300px', height:'300px', zIndex:'-99999', opacity:'0.01', pointerEvents:'none' });
            document.body.appendChild(placeholder);

            ytPlayer = new globalWindow.YT.Player('yt-hidden-player', {
                host: 'https://www.youtube-nocookie.com',
                height: '300', width: '300', 
                videoId: currentVideoIds[0], 
                playerVars: { 'autoplay': 0, 'controls': 0, 'playsinline': 1 },
                events: {
                    'onReady': () => { isYtReady = true; },
                    'onStateChange': onPlayerStateChange,
                    'onError': onPlayerError 
                }
            });
        }
    }, 300);

    function onPlayerError(event) {
        currentVideoIndex++;
        if (currentVideoIndex < currentVideoIds.length) {
            UI.updateWidgetText("음악 연결 우회 중...", `대체 곡 연결 시도 (${currentVideoIndex + 1}/${currentVideoIds.length})`);
            setTimeout(playCurrentIndex, 300); 
        } else {
            UI.updateWidgetText("⚠️ 모든 재생 우회 실패", "다시 분석(✨)을 눌러주세요.");
            document.getElementById('bgm-play-btn').innerText = '▶';
        }
    }

    function playCurrentIndex() {
        if(!currentVideoIds.length) return;
        if(currentVideoIndex >= currentVideoIds.length) currentVideoIndex = 0;
        
        if(isYtReady && ytPlayer) {
             ytPlayer.loadVideoById(currentVideoIds[currentVideoIndex]);
             ytPlayer.unMute();
             ytPlayer.setVolume(30);
             UI.updateWidgetText("재생 준비 중...", `로딩 🎧`);
        }
    }

    // ===================================================================================
    // [2] CSS 스타일 (변경 없음)
    // ===================================================================================
    GM_addStyle(`
        #ai-bgm-widget { position: fixed; z-index: 999998; background: #2c2c2e; border-radius: 30px; box-shadow: 0 8px 20px rgba(0,0,0,0.5); display: flex; align-items: center; padding: 4px 9px; box-sizing: border-box; transition: width 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), height 0.3s ease, border-radius 0.3s ease; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; user-select: none; overflow: hidden; }
        #ai-bgm-widget.collapsed { width: 48px; height: 48px; border-radius: 50%; cursor: pointer; justify-content: center; padding: 4px; }
        #ai-bgm-widget.collapsed .bgm-details, #ai-bgm-widget.collapsed .bgm-controls, #ai-bgm-widget.collapsed .bgm-progress-container, #ai-bgm-widget.collapsed .bgm-sync, #ai-bgm-widget.collapsed .bgm-heart { display: none !important; }
        #ai-bgm-widget.expanded { width: 320px; height: 64px; cursor: move; }
        .bgm-album-art { width: 34px; height: 34px; min-width: 34px; background: #90caf9; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 800; font-size: 8px; text-align: center; line-height: 1.1; box-shadow: inset 0 0 10px rgba(255,255,255,0.2), 0 2px 5px rgba(0,0,0,0.2); cursor: pointer; z-index: 2; }
        .bgm-details { margin-left: 10px; margin-right: 50px; display: flex; flex-direction: column; justify-content: flex-start; overflow: hidden; height: 100%; width: 100%; pt: 2px;}
        .bgm-title-wrapper { overflow: hidden; white-space: nowrap; width: 100%; position: relative; display: flex; }
        .bgm-title { display: inline-block; color: #ffffff; font-size: 11px; font-weight: 700; padding-left: 100%; animation: marquee 14s linear infinite; }
        @keyframes marquee { 0% { transform: translate(0, 0); } 100% { transform: translate(-100%, 0); } }
        .bgm-artist { color: #98989d; font-size: 9px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }
        .bgm-heart { color: #ff5c5c; font-size: 12px; position: absolute; right: 15px; top: 9px; cursor: pointer; }
        .bgm-sync { color: #90caf9; font-size: 12px; position: absolute; right: 34px; top: 8px; cursor: pointer; transition: transform 0.2s; }
        .bgm-sync:hover { transform: scale(1.2); }
        .bgm-sync.spinning { animation: spin 1s linear infinite; pointer-events: none;}
        .bgm-progress-container { position: absolute; bottom: 21px; left: 54px; right: 15px; display: flex; align-items: center; gap: 4px; }
        .bgm-time { font-size: 7px; color: #98989d; font-weight: 600; width: 18px; text-align: center; }
        .bgm-bar-bg { flex: 1; height: 2px; background: #48484a; border-radius: 1px; position: relative; cursor: pointer; }
        .bgm-bar-fill { width: 0%; height: 100%; background: #ffffff; border-radius: 1px; position: absolute; top: 0; left: 0; }
        .bgm-bar-dot { width: 6px; height: 6px; background: #ffffff; border-radius: 50%; position: absolute; top: -2px; left: 0%; transform: translateX(-50%); box-shadow: 0 0 3px rgba(0,0,0,0.5); }
        .bgm-controls { position: absolute; bottom: 5px; left: 0; right: 0; display: flex; justify-content: center; align-items: center; gap: 15px; }
        .ctrl-btn { color: #ffffff; cursor: pointer; font-size: 10px; transition: color 0.2s; }
        .ctrl-btn:hover { color: #90caf9; }
        .ctrl-play { font-size: 11px; font-weight:bold; }
        .ctrl-auto { background: #3a3a3c; padding: 2px 6px; border-radius: 8px; transition: background 0.2s; min-width: 60px; text-align: center; }
        .ctrl-auto[data-on="true"] { background: #90caf9; color: #1e1e1e; font-weight: bold; }
        
        #bgm-settings-panel { position: fixed; z-index: 999999; width: 260px; background: #2c2c2e; border: 1px solid #48484a; border-radius: 10px; color: #ffffff; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display: none; flex-direction: column; font-family: system-ui, sans-serif; cursor: default; }
        .bgm-set-header { background: #1c1c1e; color: white; padding: 8px 10px; border-radius: 10px 10px 0 0; display: flex; justify-content: space-between; font-size: 11px; font-weight: bold; }
        .bgm-set-close { cursor: pointer; color: #ff5c5c; }
        .bgm-set-content { padding: 10px; display: flex; flex-direction: column; gap: 6px; }
        .bgm-set-content label { font-size: 10px; font-weight: bold; color: #98989d; }
        .bgm-input { width: 100%; padding: 5px 6px; border: 1px solid #48484a; background: #3a3a3c; color: white; border-radius: 5px; box-sizing: border-box; font-size: 11px; outline: none; }
        .bgm-input:focus { border-color: #90caf9; }
        .bgm-btn { background: #6A3DE8; color: white; border: none; padding: 6px; border-radius: 5px; font-weight: bold; cursor: pointer; font-size: 11px; transition: background 0.2s; margin-top: 4px; }
        .bgm-btn:hover { background: #5228CC; }
    `);

    // ===================================================================================
    // [3] UI 생성 및 동작 연결
    // ===================================================================================
    const UI = {
        els: {}, // DOM 캐싱용 객체
        init() { this.createWidget(); this.createSettings(); this.bindEvents(); },

        updateWidgetText(title, subtitle) {
            document.getElementById('bgm-title-text').innerText = title;
            document.getElementById('bgm-artist-text').innerText = subtitle;
        },

        createWidget() {
            const widget = document.createElement('div'); widget.id = 'ai-bgm-widget'; widget.className = 'collapsed';
            const posKey = 'AIBGM_Pos_V7';
            try {
                const saved = JSON.parse(localStorage.getItem(posKey));
                if (saved) { widget.style.left = Math.min(saved.x, window.innerWidth - 48) + 'px'; widget.style.top = Math.min(saved.y, window.innerHeight - 48) + 'px'; widget.style.right = 'auto'; } 
                else { widget.style.top = '15vh'; widget.style.right = '5vw'; }
            } catch {}

            const autoLabel = settings.autoSync ? `🤖 Auto: ON (${autoTurnCounter}/${AUTO_TURN_THRESHOLD})` : "🤖 Auto: OFF";
            
            widget.innerHTML = `
                <div class="bgm-album-art" id="bgm-art-click">AI<br>BGM</div>
                <div class="bgm-details">
                    <div class="bgm-title-wrapper"><div class="bgm-title" id="bgm-title-text">AI BGM 스탠바이</div></div>
                    <div class="bgm-artist" id="bgm-artist-text">✨ 버튼을 누르면 AI가 선곡합니다</div>
                </div>
                <div class="bgm-sync" id="bgm-sync-btn" title="전체 분위기 읽고 자동 탐색">✨</div>
                <div class="bgm-heart">♥</div>
                <div class="bgm-progress-container">
                    <div class="bgm-time" id="bgm-time-cur">0:00</div>
                    <div class="bgm-bar-bg" id="bgm-progress-bg">
                        <div class="bgm-bar-fill" id="bgm-progress-fill"></div>
                        <div class="bgm-bar-dot" id="bgm-progress-dot"></div>
                    </div>
                    <div class="bgm-time" id="bgm-time-dur">-:--</div>
                </div>
                <div class="bgm-controls">
                    <span class="ctrl-btn" title="설정" id="bgm-open-settings">⚙️</span>
                    <span class="ctrl-btn" id="bgm-prev-btn" title="이전 추천 브금">⏮</span>
                    <span class="ctrl-btn ctrl-play" id="bgm-play-btn">▶</span>
                    <span class="ctrl-btn" id="bgm-next-btn" title="다음 추천 브금">⏭</span>
                    <span class="ctrl-btn ctrl-auto" id="bgm-auto-btn" data-on="${settings.autoSync}">${autoLabel}</span>
                    <span class="ctrl-btn" title="최소화" id="bgm-collapse-btn">✕</span>
                </div>
            `;
            document.body.appendChild(widget);

            // 캐싱 최적화
            ['time-cur', 'time-dur', 'progress-fill', 'progress-dot', 'play-btn', 'auto-btn', 'sync-btn'].forEach(id => {
                this.els[id] = document.getElementById(`bgm-${id}`);
            });

            // 드래그 로직 통합
            let isDragging = false, startX, startY, startLeft, startTop, movedDist = 0;
            const toggleDrag = (e, start) => {
                if (start) {
                    if (['bgm-collapse-btn','bgm-play-btn','bgm-prev-btn','bgm-next-btn','bgm-sync-btn','bgm-open-settings','bgm-auto-btn'].includes(e.target.id) || e.target.classList.contains('bgm-bar-bg')) return;
                    isDragging = true; movedDist = 0; 
                    const evt = e.touches ? e.touches[0] : e;
                    startX = evt.clientX; startY = evt.clientY;
                    const rect = widget.getBoundingClientRect(); startLeft = rect.left; startTop = rect.top; widget.style.transition = 'none'; 
                } else if (isDragging) {
                    isDragging = false; widget.style.transition = 'width 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), height 0.3s ease, border-radius 0.3s ease';
                    if (movedDist >= 5) localStorage.setItem(posKey, JSON.stringify({ x: widget.offsetLeft, y: widget.offsetTop }));
                }
            };
            const moveDrag = (e) => {
                if (!isDragging) return; 
                const evt = e.touches ? e.touches[0] : e;
                const dx = evt.clientX - startX; const dy = evt.clientY - startY; movedDist = Math.abs(dx) + Math.abs(dy);
                widget.style.left = Math.max(0, Math.min(window.innerWidth - widget.offsetWidth, startLeft + dx)) + 'px'; 
                widget.style.top = Math.max(0, Math.min(window.innerHeight - widget.offsetHeight, startTop + dy)) + 'px'; 
                UI.updateSettingsPosition();
            };

            widget.addEventListener('mousedown', e => toggleDrag(e, true)); document.addEventListener('mousemove', moveDrag, { passive: false }); document.addEventListener('mouseup', e => toggleDrag(e, false));
            widget.addEventListener('touchstart', e => toggleDrag(e, true), { passive: true }); document.addEventListener('touchmove', moveDrag, { passive: false }); document.addEventListener('touchend', e => toggleDrag(e, false));
            this.getMovedDist = () => movedDist;
        },

        createSettings() { 
            const panel = document.createElement('div'); panel.id = 'bgm-settings-panel';
            panel.innerHTML = `
                <div class="bgm-set-header"><span>🎵 API 설정</span><span class="bgm-set-close" id="bgm-set-close">✕</span></div>
                <div class="bgm-set-content">
                    <label>API 제공자</label><select id="bgm-cfg-provider" class="bgm-input"><option value="google">Google API</option><option value="firebase">Firebase Vertex AI</option></select>
                    <label>사용 모델</label><select id="bgm-cfg-model" class="bgm-input"><option value="gemini-3.5-flash">3.5 Flash</option><option value="gemini-3.1-pro-preview">3.1 Pro</option></select>
                    <div id="bgm-grp-key"><label>API 키</label><input type="password" id="bgm-cfg-key" class="bgm-input" placeholder="Google API Key 입력"></div>
                    <div id="bgm-grp-fb" style="display:none;"><label>Firebase 설정</label><textarea id="bgm-cfg-fb" class="bgm-input" style="height:65px;" placeholder="firebaseConfig = {...}"></textarea></div>
                    <button class="bgm-btn" id="bgm-btn-save">설정 저장</button>
                </div>`;
            document.body.appendChild(panel);
        },

        updateSettingsPosition() {
            const widget = document.getElementById('ai-bgm-widget'); const panel = document.getElementById('bgm-settings-panel');
            if (widget && panel && panel.style.display === 'flex') { const rect = widget.getBoundingClientRect(); panel.style.left = rect.left + 'px'; panel.style.top = (rect.bottom + 6) + 'px'; }
        },

        bindEvents() {
            const widget = document.getElementById('ai-bgm-widget'); const panel = document.getElementById('bgm-settings-panel');

            document.getElementById('bgm-art-click').onclick = (e) => {
                e.stopPropagation(); if (this.getMovedDist() >= 5) return; 
                widget.classList.toggle('expanded'); widget.classList.toggle('collapsed');
                if (widget.classList.contains('collapsed')) panel.style.display = 'none';
            };
            document.getElementById('bgm-collapse-btn').onclick = (e) => { e.stopPropagation(); widget.classList.remove('expanded'); widget.classList.add('collapsed'); panel.style.display = 'none'; };

            this.els['play-btn'].onclick = (e) => {
                e.stopPropagation();
                if (!isYtReady || !ytPlayer || typeof ytPlayer.getPlayerState !== 'function') return alert('로딩 중입니다.'); 
                if ([1, 3].includes(ytPlayer.getPlayerState())) ytPlayer.pauseVideo(); 
                else { ytPlayer.unMute(); ytPlayer.setVolume(30); ytPlayer.playVideo(); }
            };

            document.getElementById('bgm-next-btn').onclick = (e) => { e.stopPropagation(); if(currentVideoIds.length > 1) { currentVideoIndex = (currentVideoIndex + 1) % currentVideoIds.length; playCurrentIndex(); }};
            document.getElementById('bgm-prev-btn').onclick = (e) => { e.stopPropagation(); if(currentVideoIds.length > 1) { currentVideoIndex = (currentVideoIndex - 1 + currentVideoIds.length) % currentVideoIds.length; playCurrentIndex(); }};

            this.els['auto-btn'].onclick = (e) => {
                e.stopPropagation();
                settings.autoSync = !settings.autoSync; saveSettings();
                autoTurnCounter = 0; 
                e.target.setAttribute('data-on', settings.autoSync);
                e.target.innerText = settings.autoSync ? `🤖 Auto: ON (0/${AUTO_TURN_THRESHOLD})` : '🤖 Auto: OFF';
            };

            document.getElementById('bgm-open-settings').onclick = (e) => { e.stopPropagation(); panel.style.display = panel.style.display === 'flex' ? 'none' : 'flex'; UI.updateSettingsPosition(); };
            document.getElementById('bgm-set-close').onclick = (e) => { e.stopPropagation(); panel.style.display = 'none'; };
            
            const selProvider = document.getElementById('bgm-cfg-provider');
            selProvider.value = settings.provider || 'google'; document.getElementById('bgm-cfg-key').value = settings.apiKey || '';
            document.getElementById('bgm-cfg-fb').value = settings.firebaseConfig || ''; document.getElementById('bgm-cfg-model').value = settings.model || 'gemini-3.5-flash';
            selProvider.onchange = () => { document.getElementById('bgm-grp-key').style.display = selProvider.value === 'google' ? 'block' : 'none'; document.getElementById('bgm-grp-fb').style.display = selProvider.value === 'google' ? 'none' : 'block'; };
            selProvider.onchange();

            document.getElementById('bgm-btn-save').onclick = (e) => {
                e.stopPropagation(); settings.provider = selProvider.value; settings.model = document.getElementById('bgm-cfg-model').value;
                settings.apiKey = document.getElementById('bgm-cfg-key').value; settings.firebaseConfig = document.getElementById('bgm-cfg-fb').value;
                saveSettings(); panel.style.display = 'none';
            };

            this.els['sync-btn'].onclick = async (e) => {
                e.stopPropagation(); const btn = e.target; if (btn.classList.contains('spinning')) return;
                autoTurnCounter = 0; 
                if(settings.autoSync) this.els['auto-btn'].innerText = `🤖 Auto: ON (0/${AUTO_TURN_THRESHOLD})`;
                
                btn.classList.add('spinning'); 
                UI.updateWidgetText("AI 맥락 파악 중...", "가장 찰떡인 BGM 키워드를 고릅니다 ✨");
                
                try { await analyzeContextAndSearch(); } 
                catch(err) { UI.updateWidgetText("⚠️ 분석 실패", "설정창(⚙️)에서 API 키를 확인해주세요."); console.error(err); } 
                finally { btn.classList.remove('spinning'); }
            };
        }
    };

    // ===================================================================================
    // [4] 3단계 폭포수 엔진 (통합 및 경량화 완료)
    // ===================================================================================
    function extractVideoIds(htmlText) {
        const ids = [];
        const regex = /("videoId"\s*:\s*"|\/watch\?v=|youtu\.be\/|v%3D)([a-zA-Z0-9_-]{11})/g;
        let match;
        while ((match = regex.exec(htmlText)) !== null) if(!ids.includes(match[2])) ids.push(match[2]);
        return ids;
    }

    function executeCascadeSearch(query, step = 0) {
        const safeQuery = query.includes("BGM") || query.includes("OST") ? query : query + " BGM OST"; 
        
        const engines = [
            { name: "PC 서버 연결 중...", url: `https://www.youtube.com/results?search_query=${encodeURIComponent(safeQuery)}&sp=EgIQAQ%3D%3D`, ua: "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36" },
            { name: "모바일 우회 중...", url: `https://m.youtube.com/results?search_query=${encodeURIComponent(safeQuery)}&sp=EgIQAQ%3D%3D`, ua: "Mozilla/5.0 (iPhone; CPU iPhone OS 16_0 like Mac OS X) AppleWebKit/605.1.15 Mobile/15E148 Safari/604.1" },
            { name: "백업 서버 탐색 중...", url: `https://html.duckduckgo.com/html/?q=${encodeURIComponent('site:youtube.com ' + query)}&kl=kr-kr`, ua: navigator.userAgent }
        ];

        if (step >= engines.length) {
            UI.updateWidgetText("⚠️ 노래 검색 최종 실패", "다른 상황(대사)으로 재분석을 권장합니다.");
            UI.els['play-btn'].innerText = '▶';
            currentVideoIds = ['jfKfPfyJRdk']; 
            return;
        }

        UI.updateWidgetText(`🔍 [${query}]`, `엔진 ${step+1}: ${engines[step].name}`);
        
        GM_xmlhttpRequest({
            method: "GET", url: engines[step].url, anonymous: true, timeout: 5000,
            headers: { "User-Agent": engines[step].ua, "Cookie": "CONSENT=YES+cb.20230101-01-p0.ko+FX+433;" },
            onload: (res) => {
                const ids = extractVideoIds(res.responseText);
                if (ids.length > 0) { currentVideoIds = ids.slice(0, 15); currentVideoIndex = 0; playCurrentIndex(); }
                else executeCascadeSearch(query, step + 1);
            },
            onerror: () => executeCascadeSearch(query, step + 1),
            ontimeout: () => executeCascadeSearch(query, step + 1)
        });
    }

    // ===================================================================================
    // [5] 진행바 동기화 (캐싱 적용 최적화)
    // ===================================================================================
    const fmtTime = sec => (isNaN(sec) || !isFinite(sec)) ? "0:00" : `${Math.floor(sec / 60)}:${Math.floor(sec % 60).toString().padStart(2, '0')}`;

    function onPlayerStateChange(event) {
        const btn = UI.els['play-btn'];
        if (event.data === 1) { 
            btn.innerText = '❚❚';
            try { const data = ytPlayer.getVideoData(); if(data?.title) UI.updateWidgetText(data.title, data.author); } catch(e) {}
        } 
        else if (event.data === 2) btn.innerText = '▶';
        else if (event.data === 0) { 
            btn.innerText = '▶';
            if(currentVideoIds.length > 1) { currentVideoIndex = (currentVideoIndex + 1) % currentVideoIds.length; playCurrentIndex(); }
        }
    }

    setInterval(() => {
        if (isYtReady && ytPlayer && typeof ytPlayer.getPlayerState === 'function' && ytPlayer.getPlayerState() === 1) {
            const cur = ytPlayer.getCurrentTime() || 0, dur = ytPlayer.getDuration() || 0, pct = dur > 0 ? (cur / dur) * 100 : 100;
            UI.els['time-cur'].innerText = fmtTime(cur); 
            UI.els['time-dur'].innerText = '-' + fmtTime(Math.max(0, dur - cur));
            UI.els['progress-fill'].style.width = pct + '%'; 
            UI.els['progress-dot'].style.left = pct + '%';
        }
    }, 500);

    // ===================================================================================
    // [6] AI 분석
    // ===================================================================================
    const hashText = text => text.split('').reduce((a, b) => { a = ((a << 5) - a) + b.charCodeAt(0); return a & a }, 0);

    async function getRecentContext() {
        const path = location.pathname.match(/\/stories\/([^/]+)\/episodes\/([^/]+)/);
        if (!path) return Array.from(document.querySelectorAll('div[dir="auto"], .whitespace-pre-wrap, p')).slice(-20).map(b => b.textContent.trim()).filter(Boolean).join('\n\n'); 
        try {
            const token = document.cookie.split(";").map(c => c.trim()).find(c => c.startsWith("access_token="))?.slice(13);
            if (!token) return ""; 
            const res = await fetch(`https://crack-api.wrtn.ai/crack-gen/v3/chats/${path[2]}/messages?limit=10`, { headers: { Authorization: `Bearer ${token}` } });
            const json = await res.json(); 
            return (json.data ?? json).messages?.reverse().map(m => `[${m.role === 'user' ? '사용자' : '캐릭터'}]: ${m.content}`).join("\n\n") || "";
        } catch(e) { return ""; }
    }

    async function analyzeContextAndSearch() {
        const context = await getRecentContext();
        if (!context) throw new Error("대화 내용이 없습니다.");
        
        const currentHash = hashText(context);
        if(currentHash === lastContextHash) return console.log("대화 내용 변경 없음. API 호출 스킵.");
        lastContextHash = currentHash;

        const sysPrompt = `당신은 롤플레잉 게임의 베테랑 음악 감독입니다. 주어진 대화(최근 3~5턴)의 "전체적인 흐름과 스토리 맥락"을 파악하고, 분위기에 완벽하게 어울리는 유튜브 배경음악 검색어를 제시하세요.\n[규칙]\n1. 최근 대화의 기승전결 분석.\n2. (장르/악기) + (무드/감정) + (상황/배경) 조합.\n3. 반드시 'BGM' 또는 'OST' 포함.\n4. 실존 가수, 노래제목 절대 금지.\n5. 오직 검색어 한 줄만 출력 (특수기호, 설명 금지).\n예: 사이버펑크 어두운 골목 긴장되는 BGM`;
        
        const modelName = settings.model || 'gemini-3.5-flash';
        let generatedQuery = "";

        if (settings.provider === 'firebase') {
            const config = (() => { try { const m = settings.firebaseConfig.match(/firebaseConfig\s*=\s*(\{[\s\S]*?\});/); return m ? new Function("return " + m[1])() : null; } catch(e) { return null; }})();
            if (!config) throw new Error("Invalid Firebase Config");
            const { initializeApp } = await import("https://www.gstatic.com/firebasejs/12.8.0/firebase-app.js");
            const { getAI, getGenerativeModel, VertexAIBackend } = await import("https://www.gstatic.com/firebasejs/12.8.0/firebase-ai.js");
            const ai = getAI(initializeApp(config, "bgm-ai-" + Date.now()), { backend: new VertexAIBackend('global') });
            generatedQuery = (await (await getGenerativeModel(ai, { model: modelName, systemInstruction: sysPrompt })).generateContent(context)).response.text().trim();
        } else {
            generatedQuery = await new Promise((resolve, reject) => {
                GM_xmlhttpRequest({
                    method: "POST", url: `https://generativelanguage.googleapis.com/v1beta/models/${modelName}:generateContent?key=${settings.apiKey}`, headers: { "Content-Type": "application/json" },
                    data: JSON.stringify({ system_instruction: { parts: [{ text: sysPrompt }] }, contents: [{ parts: [{ text: context }] }] }),
                    onload: res => { try { resolve(JSON.parse(res.responseText).candidates[0].content.parts[0].text.trim()); } catch(e) { reject(e); } }, onerror: reject
                });
            });
        }
        
        currentSearchQuery = generatedQuery.replace(/['"\[\]\n\r*\-\,\.]/g, '').trim();
        executeCascadeSearch(currentSearchQuery);
    }

    // ===================================================================================
    // [7] 말풍선 카운터 (버그 픽스 및 로직 유지)
    // ===================================================================================
    function handleChatTurnEnded(addedCount = 1) {
        if(!settings.autoSync) return; 

        autoTurnCounter += addedCount;
        const autoBtn = UI.els['auto-btn'];

        if (autoTurnCounter >= AUTO_TURN_THRESHOLD) {
            if (autoBtn) autoBtn.innerText = `🤖 분석 중...`;
            autoTurnCounter = 0; 
            
            clearTimeout(autoSyncTimer);
            autoSyncTimer = setTimeout(() => {
                const btn = UI.els['sync-btn'];
                if (btn && !btn.classList.contains('spinning')) {
                    // 치명적 버그 수정: triggerAnalysis -> analyzeContextAndSearch()
                    analyzeContextAndSearch().then(() => {
                        if (autoBtn && settings.autoSync) autoBtn.innerText = `🤖 Auto: ON (0/${AUTO_TURN_THRESHOLD})`;
                    });
                }
            }, 1000);
            
        } else if (autoBtn) {
            autoBtn.innerText = `🤖 Auto: ON (${autoTurnCounter}/${AUTO_TURN_THRESHOLD})`;
        }
    }

    let lastBubbleCount = -1;
    setInterval(() => {
        if(!settings.autoSync) return;
        const bubbles = document.querySelectorAll('[data-message-group-id]');
        if (lastBubbleCount === -1) { lastBubbleCount = bubbles.length; return; }
        
        if (bubbles.length > lastBubbleCount) {
            handleChatTurnEnded(bubbles.length - lastBubbleCount);
            lastBubbleCount = bubbles.length;
        } else if (bubbles.length < lastBubbleCount - 2) {
            lastBubbleCount = bubbles.length; // 초기화
        }
    }, 1500);

    // 초기화
    UI.init();
})();
